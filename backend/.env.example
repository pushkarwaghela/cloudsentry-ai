# CloudSentry AI Environment Configuration

# Provider selection: auto | deterministic | ollama | cloud
LLM_PROVIDER=auto

# Local Ollama Configuration (if using Mode 2)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# Cloud API Keys (if using Mode 3)
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Live Cloud Connector Credentials (optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_CLOUDTRAIL_SQS_URL=

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_EVENTHUB_CONN_STR=
AZURE_EVENTHUB_NAME=
